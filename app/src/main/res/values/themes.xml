<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GhostLock" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gl_accent</item>
        <item name="colorOnPrimary">@color/gl_on_accent</item>
        <item name="colorPrimaryContainer">@color/gl_accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/gl_accent_soft</item>
        <item name="colorSecondary">@color/gl_accent</item>
        <item name="colorOnSecondary">@color/gl_on_accent</item>
        <item name="colorTertiary">@color/gl_accent_soft</item>
        <item name="android:colorBackground">@color/gl_bg</item>
        <item name="colorSurface">@color/gl_surface</item>
        <item name="colorOnSurface">@color/gl_on_surface</item>
        <item name="colorSurfaceVariant">@color/gl_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/gl_on_surface_variant</item>
        <item name="colorOutline">@color/gl_outline</item>
        <item name="android:statusBarColor">@color/gl_bg</item>
        <item name="android:navigationBarColor">@color/gl_bg</item>
        <item name="android:windowBackground">@color/gl_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/Theme.GhostLock.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.GhostLock.BottomSheet</item>
    </style>

    <style name="Theme.GhostLock.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/gl_surface_container</item>
        <item name="colorOnSurface">@color/gl_on_surface</item>
    </style>

    <style name="Theme.GhostLock.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/gl_surface</item>
        <item name="colorOnSurface">@color/gl_on_surface</item>
    </style>

    <style name="GlCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/gl_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gl_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="GlSectionTitle">
        <item name="android:textColor">@color/gl_on_surface_variant</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="GlValue">
        <item name="android:textColor">@color/gl_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GlButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
        <item name="rippleColor">@color/gl_ripple</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="GlButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
        <item name="rippleColor">@color/gl_ripple</item>
        <item name="strokeColor">@color/gl_outline</item>
        <item name="android:textColor">@color/gl_btn_text</item>
    </style>

    <style name="GlButton.Compact" parent="GlButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="GlButton.Compact.Outlined" parent="GlButton.Outlined">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="GlIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/gl_on_surface_variant</item>
        <item name="iconSize">24dp</item>
        <item name="rippleColor">@color/gl_ripple</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
    </style>
</resources>
